{
    "name": "inanepain/stdlib",
    "description": "Common classes that cover a wide range of cases that are used throughout the inanepain libraries.",
    "type": "library",
    "license": "Unlicense",
    "homepage": "https://github.com/inanepain/stdlib",
    "readme": "README.adoc",
    "authors": [
        {
            "name": "Philip Michael Raab",
            "email": "philip@cathedral.co.za",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "philip@cathedral.co.za",
        "issues": "https://github.com/inanepain/stdlib/issues"
    },
    "keywords": [
        "inanepain",
        "inane",
        "stdlib",
        "json",
        "array",
        "exception",
        "notice",
        "config"
    ],
    "autoload": {
        "psr-4": {
            "Inane\\Stdlib\\": "src/"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Inane\\Stdlib\\Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "discard-changes": true,
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "require": {
        "php": ">=8.5",
        "psr/container": "*",
        "ext-ctype": "*",
        "ext-intl": "*",
        "ext-libxml": "*",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "*"
    },
    "scripts": {
        "mk-doc-dir": [
            "mkdir -p doc/{changelog,readme}",
            "mkdir -p doc/changelog/release",
            "mkdir -p doc/readme/part",
            "touch doc/{changelog,readme}/index.adoc",
            "touch doc/changelog/release/0.0.0.adoc",
            "touch doc/readme/part/install.adoc"
        ],
        "build": [
            "echo build: doc: db",
            "@build-changelog",
            "@build-readme",
            "echo doc: db: built"
        ],
        "build-changelog": [
            "echo building: changelog...",
            "asciidoctor-reducer -o CHANGELOG.adoc doc/changelog/index.adoc"
        ],
        "build-readme": [
            "echo building: readme...",
            "asciidoctor-reducer -o README.adoc doc/readme/index.adoc"
        ]
    }
}
